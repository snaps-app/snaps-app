{
 "defs": {
  "ContextBudget": {
   "additionalProperties": false,
   "description": "Orcamento de contexto de uma fase (D32).\n\n`max_tokens` e o teto do prompt montado, em tokens ESTIMADOS (o snapshot\nmarca `estimated=true`). `prioridade` reordena as secoes podaveis, da mais\npara a menos importante; ausente, vale `SECOES_PODAVEIS`.",
   "properties": {
    "max_tokens": {
     "exclusiveMinimum": 0,
     "title": "Max Tokens",
     "type": "integer"
    },
    "prioridade": {
     "anyOf": [
      {
       "items": {
        "enum": [
         "governance_docs",
         "decisions",
         "test_plans",
         "plans",
         "walkthroughs",
         "relevant_snaps"
        ],
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Prioridade"
    }
   },
   "required": [
    "max_tokens"
   ],
   "title": "ContextBudget",
   "type": "object"
  },
  "SessionPolicy": {
   "additionalProperties": false,
   "description": "`session_policy` de uma fase (PRD §4.6.2, D69, D72).\n\nSobrescreve o default do provider em `services.session_policy`. Sem campo\nde perfil: o perfil entra na Sprint 23.0 (SNA-RD-169). Chave ausente herda\no default do provider.",
   "properties": {
    "mode": {
     "anyOf": [
      {
       "enum": [
        "auto",
        "sticky",
        "fresh"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Mode"
    },
    "compact_when": {
     "anyOf": [
      {
       "enum": [
        "projected_headroom_insufficient",
        "never"
       ],
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Compact When"
    },
    "new_session_when": {
     "anyOf": [
      {
       "items": {
        "enum": [
         "runtime_or_model_change",
         "access_or_skill_contract_change",
         "reviewer_independence",
         "context_contamination",
         "provider_session_unavailable"
        ],
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "New Session When"
    },
    "max_compactions": {
     "anyOf": [
      {
       "minimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Max Compactions"
    },
    "safety_margin": {
     "anyOf": [
      {
       "const": "provider_default",
       "type": "string"
      },
      {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Safety Margin"
    },
    "carry": {
     "anyOf": [
      {
       "items": {
        "enum": [
         "artifact_refs",
         "decisions",
         "unresolved_questions",
         "current_plan",
         "test_state"
        ],
        "type": "string"
       },
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Carry"
    }
   },
   "title": "SessionPolicy",
   "type": "object"
  }
 },
